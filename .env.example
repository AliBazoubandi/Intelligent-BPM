# ==========================================
# RobinFlow (رابین‌فلو) - Environment Template
# Intelligent Business Process Management System
# Copy this file to .env and configure your environment
# ==========================================

APP_NAME=RobinFlow


# Database Connection
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=org_process

# Hermes AI Agent Settings
HERMES_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_KEY=your_hermes_api_key_here
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT=120

# Background Worker Settings
# Path to php executable (e.g., C:\xampp\php\php.exe or /usr/bin/php)
PHP_BIN=

# Bale Messenger API Settings (وب‌سرویس ارسال پیام در بله)
# URL of your running Bale messenger service / proxy API
BALE_API_URL=http://127.0.0.1:8080/send
BALE_BOT_TOKEN=
BALE_API_ENABLED=true
BALE_TIMEOUT=10

